
@model IEnumerable<HospitalRecruitmentSystem.Models.JobApplication>

@{
    ViewData["Title"] = "Job Application Management";
}

<h2>Job Application Management</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        + Add New Application
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Application Number</th>
            <th>Candidate Name</th>
            <th>Job Position</th>
            <th>Application Date</th>
            <th>Application Status</th>
            <th>Interview Status</th>
            <th>HR Remarks</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ApplicationNumber</td>
                <td>@item.Candidate?.FullName</td>
                <td>@item.JobVacancy?.JobTitle</td>
                <td>@item.ApplicationDate.ToShortDateString()</td>
                <td>@item.ApplicationStatus</td>
                <td>@item.InterviewStatus</td>
                <td>@item.HRRemarks</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>
