
@model HospitalRecruitmentSystem.Models.JobApplication

@{
    ViewData["Title"] = "Create Job Application";
}

<h2>Create Job Application</h2>

<hr />

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3">
        <label>Candidate</label>
        <select asp-for="CandidateId"
                asp-items="ViewBag.CandidateId"
                class="form-control">
            <option value="">-- Select Candidate --</option>
        </select>
        <span asp-validation-for="CandidateId"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Job Vacancy</label>
        <select asp-for="JobVacancyId"
                asp-items="ViewBag.JobVacancyId"
                class="form-control">
            <option value="">-- Select Job Vacancy --</option>
        </select>
        <span asp-validation-for="JobVacancyId"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Application Status</label>
        <select asp-for="ApplicationStatus" class="form-control">
            <option value="Submitted">Submitted</option>
            <option value="Under Review">Under Review</option>
            <option value="Shortlisted">Shortlisted</option>
            <option value="Rejected">Rejected</option>
            <option value="Selected">Selected</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label>Interview Status</label>
        <select asp-for="InterviewStatus" class="form-control">
            <option value="Pending">Pending</option>
            <option value="Scheduled">Scheduled</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label>HR Remarks</label>
        <textarea asp-for="HRRemarks"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit Application
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
