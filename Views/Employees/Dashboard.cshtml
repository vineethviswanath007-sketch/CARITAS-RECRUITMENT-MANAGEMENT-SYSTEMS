
@{
    ViewData["Title"] = "Employee Onboarding Dashboard";
}

<h2>Employee Onboarding Dashboard</h2>
<p>Hospital HR – Employee onboarding and verification overview.</p>

<div class="row mt-4">

    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary shadow">
            <div class="card-body">
                <h5>Total Employees</h5>
                <h2>@ViewBag.TotalEmployees</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success shadow">
            <div class="card-body">
                <h5>Onboarding Completed</h5>
                <h2>@ViewBag.Completed</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-white bg-warning shadow">
            <div class="card-body">
                <h5>In Progress</h5>
                <h2>@ViewBag.InProgress</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card border-danger shadow">
            <div class="card-body">
                <h5>Pending Documents</h5>
                <h2>@ViewBag.PendingDocuments</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card border-info shadow">
            <div class="card-body">
                <h5>Pending Medical Fitness</h5>
                <h2>@ViewBag.PendingMedical</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card border-secondary shadow">
            <div class="card-body">
                <h5>Pending Background Verification</h5>
                <h2>@ViewBag.PendingBackground</h2>
            </div>
        </div>
    </div>

</div>

<hr />

<h4>Department-wise Employee Summary</h4>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>Department</th>
            <th>Total Employees</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in ViewBag.DepartmentSummary)
        {
            <tr>
                <td>@(item.Department ?? "Not Assigned")</td>
                <td>@item.Count</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Employee Management
    </a>

    <a asp-action="Create" class="btn btn-primary">
        + Register Employee
    </a>
</div>
