
@model HospitalRecruitmentSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>
<p>View complete employee registration and onboarding information.</p>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5>Employee Information</h5>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Employee Code</dt>
            <dd class="col-sm-8">@Model.EmployeeCode</dd>

            <dt class="col-sm-4">Employee Name</dt>
            <dd class="col-sm-8">@Model.EmployeeName</dd>

            <dt class="col-sm-4">Designation</dt>
            <dd class="col-sm-8">@Model.Designation</dd>

            <dt class="col-sm-4">Department</dt>
            <dd class="col-sm-8">@Model.Department</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.Phone</dd>

            <dt class="col-sm-4">Gender</dt>
            <dd class="col-sm-8">@Model.Gender</dd>

            <dt class="col-sm-4">Date of Birth</dt>
            <dd class="col-sm-8">@Model.DateOfBirth.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-4">Joining Date</dt>
            <dd class="col-sm-8">@Model.JoiningDate.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-4">Qualification</dt>
            <dd class="col-sm-8">@Model.Qualification</dd>

            <dt class="col-sm-4">Previous Organization</dt>
            <dd class="col-sm-8">@Model.PreviousOrganization</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@Model.Address</dd>

            <dt class="col-sm-4">Document Verification</dt>
            <dd class="col-sm-8">@Model.DocumentVerification</dd>

            <dt class="col-sm-4">Medical Fitness</dt>
            <dd class="col-sm-8">@Model.MedicalFitnessStatus</dd>

            <dt class="col-sm-4">Background Verification</dt>
            <dd class="col-sm-8">@Model.BackgroundVerification</dd>

            <dt class="col-sm-4">Onboarding Status</dt>
            <dd class="col-sm-8">@Model.OnboardingStatus</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-warning">Edit Employee</a>

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
