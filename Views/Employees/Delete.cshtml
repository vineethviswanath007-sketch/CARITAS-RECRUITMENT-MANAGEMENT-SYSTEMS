
@model HospitalRecruitmentSystem.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this employee?
    This action cannot be undone.
</div>

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        Employee Information
    </div>

    <div class="card-body">
        <p><strong>Employee Code:</strong> @Model.EmployeeCode</p>
        <p><strong>Employee Name:</strong> @Model.EmployeeName</p>
        <p><strong>Designation:</strong> @Model.Designation</p>
        <p><strong>Department:</strong> @Model.Department</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Confirm Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>
