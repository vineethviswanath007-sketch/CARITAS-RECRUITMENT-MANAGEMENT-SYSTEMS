@model HospitalRecruitmentSystem.Models.Interview

@{
    ViewData["Title"] = "New Interview Evaluation";
}

<h2>New Interview Evaluation</h2>
<p>Enter candidate interview details and evaluation scores.</p>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div class="row">

        <div class="col-md-6 mb-3">
            <label asp-for="CandidateId" class="form-label">Candidate</label>
            <select asp-for="CandidateId"
                    asp-items="ViewBag.CandidateId"
                    class="form-select">
                <option value="">-- Select Candidate --</option>
            </select>
            <span asp-validation-for="CandidateId" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InterviewDate" class="form-label">Interview Date</label>
            <input asp-for="InterviewDate" type="date" class="form-control" />
            <span asp-validation-for="InterviewDate" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InterviewMode" class="form-label">Interview Mode</label>
            <select asp-for="InterviewMode" class="form-select">
                <option value="Offline">Offline</option>
                <option value="Online">Online</option>
                <option value="Telephonic">Telephonic</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InterviewRound" class="form-label">Interview Round</label>
            <select asp-for="InterviewRound" class="form-select">
                <option value="HR">HR Round</option>
                <option value="Technical">Technical Round</option>
                <option value="Department Head">Department Head</option>
                <option value="Final">Final Round</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InterviewPanel" class="form-label">Interview Panel</label>
            <input asp-for="InterviewPanel" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="TechnicalKnowledgeScore" class="form-label">Technical Knowledge Score (0–10)</label>
            <input asp-for="TechnicalKnowledgeScore" type="number"
                   min="0" max="10" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CommunicationSkillsScore" class="form-label">Communication Skills Score (0–10)</label>
            <input asp-for="CommunicationSkillsScore" type="number"
                   min="0" max="10" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="OverallPerformanceScore" class="form-label">Overall Performance Score (0–10)</label>
            <input asp-for="OverallPerformanceScore" type="number"
                   min="0" max="10" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="InterviewResult" class="form-label">Interview Result</label>
            <select asp-for="InterviewResult" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Selected">Selected</option>
                <option value="Rejected">Rejected</option>
                <option value="On Hold">On Hold</option>
            </select>
        </div>

        <div class="col-md-12 mb-3">
            <label asp-for="InterviewerFeedback" class="form-label">Interviewer Feedback</label>
            <textarea asp-for="InterviewerFeedback"
                      class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-12 mb-3">
            <label asp-for="Evaluation" class="form-label">Evaluation Summary</label>
            <textarea asp-for="Evaluation"
                      class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-12 mb-3">
            <label asp-for="Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Remarks"
                      class="form-control" rows="2"></textarea>
        </div>

    </div>

    <button type="submit" class="btn btn-primary">Save Evaluation</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}