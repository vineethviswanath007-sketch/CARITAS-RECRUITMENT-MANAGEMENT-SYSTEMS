@model HospitalRecruitmentSystem.Models.Candidate

@{
    ViewData["Title"] = "Register Candidate";
}

<h2 class="mb-4">Candidate Registration</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <h5 class="mb-3">Personal Details</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FullName" class="form-label">Candidate Name</label>
                    <input asp-for="FullName" class="form-control"
                           placeholder="Enter candidate name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control"
                           placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label">Phone Number</label>
                    <input asp-for="Phone" class="form-control"
                           placeholder="Enter phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                        <option value="Prefer not to say">Prefer not to say</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Age" class="form-label">Age</label>
                    <input asp-for="Age" type="number" class="form-control"
                           placeholder="Enter age" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Place" class="form-label">Candidate Location</label>
                    <input asp-for="Place" class="form-control"
                           placeholder="Enter place" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Religion" class="form-label">Religion (Optional)</label>
                    <input asp-for="Religion" class="form-control"
                           placeholder="Enter religion" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Caste" class="form-label">Caste (Optional)</label>
                    <input asp-for="Caste" class="form-control"
                           placeholder="Enter caste" />
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Professional Details</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Qualification" class="form-label">
                        Educational Qualification
                    </label>
                    <input asp-for="Qualification" class="form-control"
                           placeholder="Enter qualification" />
                    <span asp-validation-for="Qualification" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ExperienceYears" class="form-label">
                        Years of Experience
                    </label>
                    <input asp-for="ExperienceYears" type="number"
                           step="0.1" class="form-control"
                           placeholder="Enter experience in years" />
                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastWorkedOrganization" class="form-label">
                        Last Worked Organization
                    </label>
                    <input asp-for="LastWorkedOrganization" class="form-control"
                           placeholder="Enter previous organization" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AppliedPosition" class="form-label">
                        Applied Position
                    </label>
                    <input asp-for="AppliedPosition" class="form-control"
                           placeholder="Enter applied position" />
                    <span asp-validation-for="AppliedPosition" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="DepartmentId" class="form-label">
                        Hospital Department
                    </label>
                    <select asp-for="DepartmentId"
                            asp-items="ViewBag.DepartmentId"
                            class="form-select">
                        <option value="">Select Department</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <div class="alert alert-info">
                Candidate ID, application submission date and initial
                application status will be generated automatically.
            </div>

            <button type="submit" class="btn btn-primary">
                Submit Application
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back to Candidates
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
