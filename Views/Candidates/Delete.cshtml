@model HospitalRecruitmentSystem.Models.Candidate

@{
    ViewData["Title"] = "Delete Candidate";
}

<h2>Delete Candidate</h2>

<h4>Are you sure you want to delete this candidate?</h4>

<hr />

<div class="card p-3">

    <dl class="row">

        <dt class="col-sm-3">Candidate Code</dt>
        <dd class="col-sm-9">@Model.CandidateCode</dd>

        <dt class="col-sm-3">Candidate Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">@Model.Gender</dd>

        <dt class="col-sm-3">Qualification</dt>
        <dd class="col-sm-9">@Model.Qualification</dd>

        <dt class="col-sm-3">Experience</dt>
        <dd class="col-sm-9">@Model.ExperienceYears</dd>

        <dt class="col-sm-3">Applied Position</dt>
        <dd class="col-sm-9">@Model.AppliedPosition</dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department?.Id</dd>

        <dt class="col-sm-3">Religion</dt>
        <dd class="col-sm-9">@Model.Religion</dd>

        <dt class="col-sm-3">Caste</dt>
        <dd class="col-sm-9">@Model.Caste</dd>

        <dt class="col-sm-3">Place</dt>
        <dd class="col-sm-9">@Model.Place</dd>

        <dt class="col-sm-3">Age</dt>
        <dd class="col-sm-9">@Model.Age</dd>

        <dt class="col-sm-3">Last Worked Organization</dt>
        <dd class="col-sm-9">@Model.LastWorkedOrganization</dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>